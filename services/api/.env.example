# Copy to .env (never commit). Generate keys: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ELBLASY_ENVIRONMENT=development
ELBLASY_DATABASE_URL=postgresql+psycopg://elblasy:elblasy@localhost:5433/elblasy_one
ELBLASY_JWT_SECRET=change-me-to-a-random-string-of-32+chars
ELBLASY_SECRET_KEYS=            # Fernet key(s), comma-separated; first encrypts, all decrypt
ELBLASY_COOKIE_SECURE=false     # true behind HTTPS (always in production)
ELBLASY_ALLOW_PRIVATE_ODOO_HOSTS=true   # dev only: lets the API reach localhost Odoo
ELBLASY_ALLOW_INSECURE_ODOO_HTTP=true   # dev only; ignored in production
